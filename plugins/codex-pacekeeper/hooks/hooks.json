{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "\"${PLUGIN_ROOT}/bin/pacekeeper-refresh\"", "timeout": 3 }] }, { "hooks": [{ "type": "command", "command": "\"${PLUGIN_ROOT}/bin/pacekeeper-tick\"", "timeout": 10 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "\"${PLUGIN_ROOT}/bin/pacekeeper-tick\"", "timeout": 3 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "\"${PLUGIN_ROOT}/bin/pacekeeper-refresh\"", "timeout": 3 }] }, { "hooks": [{ "type": "command", "command": "\"${PLUGIN_ROOT}/bin/pacekeeper-tick\"", "timeout": 5 }] }],
    "PreToolUse": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "\"${PLUGIN_ROOT}/bin/pacekeeper-tick\"", "timeout": 5 }] }],
    "PostToolUse": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "\"${PLUGIN_ROOT}/bin/pacekeeper-refresh\"", "timeout": 3 }] }],
    "PostCompact": [{ "hooks": [{ "type": "command", "command": "\"${PLUGIN_ROOT}/bin/pacekeeper-tick\"", "timeout": 5 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "\"${PLUGIN_ROOT}/bin/pacekeeper-refresh\"", "timeout": 3 }] }, { "hooks": [{ "type": "command", "command": "\"${PLUGIN_ROOT}/bin/pacekeeper-tick\"", "timeout": 5 }] }],
    "Interrupt": [{ "hooks": [{ "type": "command", "command": "\"${PLUGIN_ROOT}/bin/pacekeeper-tick\"", "timeout": 3 }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "\"${PLUGIN_ROOT}/bin/pacekeeper-tick\"", "timeout": 5 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "\"${PLUGIN_ROOT}/bin/pacekeeper-tick\"", "timeout": 5 }] }]
  }
}
